{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Input contract",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "interface": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "current_flow": {
          "type": "string"
        },
        "target_flow": {
          "type": "string"
        },
        "source_origin": {
          "type": "string"
        },
        "reviewer": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "current_flow",
        "target_flow",
        "source_origin",
        "reviewer"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "contracts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sample": {
          "type": "string"
        },
        "normalized_sample": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "optional": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "nullable": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "path": {
                "type": "string"
              },
              "evidence_files": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "name",
              "type",
              "optional",
              "nullable",
              "path",
              "evidence_files"
            ],
            "additionalProperties": false
          }
        },
        "normalization_note": {
          "type": "string"
        }
      },
      "required": [
        "contracts",
        "sample",
        "normalized_sample",
        "fields",
        "normalization_note"
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "platform": {
          "type": "string"
        },
        "api_version": {
          "type": "string"
        },
        "research_method": {
          "type": "string"
        },
        "selected_operation": {
          "type": [
            "string",
            "null"
          ]
        },
        "endpoint_reference": {
          "type": "string"
        },
        "selection_basis": {
          "enum": [
            "agent_proposal",
            "analyst_reference"
          ]
        }
      },
      "required": [
        "platform",
        "api_version",
        "research_method",
        "selected_operation",
        "endpoint_reference"
      ],
      "additionalProperties": false
    },
    "known_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "confirmed_by": {
            "type": "string"
          },
          "attribute": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "statement",
          "confirmed_by"
        ],
        "additionalProperties": false
      }
    },
    "answers": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "additional_context": {
      "type": "string"
    },
    "human_inputs_sha256": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "interface",
    "source",
    "target",
    "known_rules",
    "answers",
    "additional_context",
    "human_inputs_sha256"
  ],
  "additionalProperties": false
}
