{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Analysis contract",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "interface_id": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "input_sha256": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "target_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "operation": {
            "type": "string"
          },
          "state": {
            "enum": [
              "candidate",
              "alternative",
              "selected"
            ]
          },
          "when": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name",
          "operation",
          "state",
          "when",
          "evidence_ids"
        ],
        "additionalProperties": false
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "kind",
          "text",
          "evidence_ids"
        ],
        "additionalProperties": false
      }
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_field": {
            "type": "string"
          },
          "source_type": {
            "type": "string"
          },
          "status": {
            "enum": [
              "ready",
              "needs_input",
              "needs_lookup",
              "unmapped",
              "excluded"
            ]
          },
          "target": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "proposed_rule": {
            "type": "string"
          },
          "question_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "decision_basis": {
            "enum": [
              "proposal",
              "confirmed"
            ]
          },
          "confirmed_by": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "source_field",
          "source_type",
          "status",
          "target",
          "reason",
          "proposed_rule",
          "question_ids",
          "evidence_ids",
          "decision_basis",
          "confirmed_by"
        ],
        "additionalProperties": false
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "group": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          },
          "why": {
            "type": "string"
          },
          "affected_fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "review_status": {
            "enum": [
              "open",
              "resolved",
              "needs_clarification"
            ]
          },
          "resolution_note": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "group",
          "question",
          "hint",
          "why",
          "affected_fields"
        ],
        "additionalProperties": false
      }
    },
    "target_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "requirement": {
            "type": "string"
          },
          "status": {
            "enum": [
              "ready",
              "needs_input",
              "needs_lookup",
              "unmapped",
              "excluded"
            ]
          },
          "note": {
            "type": "string"
          },
          "question_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "field",
          "type",
          "requirement",
          "status",
          "note",
          "question_ids",
          "evidence_ids"
        ],
        "additionalProperties": false
      }
    },
    "interface_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "enum": [
              "open",
              "closed"
            ]
          },
          "question_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "description",
          "status",
          "question_ids"
        ],
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "retrieved_on": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "bytes": {
            "type": "integer"
          },
          "api_version": {
            "type": "string"
          },
          "acquisition": {
            "type": "string"
          },
          "operation": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "url",
          "note"
        ],
        "additionalProperties": false
      }
    },
    "validation_scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scenario": {
            "type": "string"
          },
          "expected": {
            "type": "string"
          }
        },
        "required": [
          "scenario",
          "expected"
        ],
        "additionalProperties": false
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "interface_id",
    "revision",
    "input_sha256",
    "generated_at",
    "summary",
    "target_candidates",
    "observations",
    "mappings",
    "questions",
    "target_requirements",
    "interface_gates",
    "evidence",
    "validation_scenarios",
    "changes",
    "limitations"
  ],
  "additionalProperties": false
}
